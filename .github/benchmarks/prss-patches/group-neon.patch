+/// Requests a wide NEON store for the ARM experiment; other targets use ordinary little-endian assignment.
+// TEMP: REMOVE BEFORE MERGE. Unsafe experimental control, not a production implementation.
+#[inline(always)]
+fn write_block(block: &mut AesBlock, word: u128) {
+    #[cfg(all(
+        target_arch = "aarch64",
+        target_endian = "little",
+        target_feature = "neon"
+    ))]
+    // SAFETY: the target enables NEON, the mutable block has 16 writable bytes, and vst1q_u8 accepts byte alignment.
+    // The low/high u64 lanes reproduce to_le_bytes on this little-endian target.
+    unsafe {
+        use core::arch::aarch64::{vcombine_u64, vcreate_u64, vreinterpretq_u8_u64, vst1q_u8};
+        let value = vcombine_u64(vcreate_u64(word as u64), vcreate_u64((word >> 64) as u64));
+        vst1q_u8(block.as_mut_ptr(), vreinterpretq_u8_u64(value));
+    }
+    #[cfg(not(all(
+        target_arch = "aarch64",
+        target_endian = "little",
+        target_feature = "neon"
+    )))]
+    {
+        *block = AesBlock::from(word.to_le_bytes());
+    }
+}
